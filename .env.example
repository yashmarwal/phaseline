SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Phase AI (api/chat.js). Without ANTHROPIC_API_KEY the chat still answers from its stored answers.
ANTHROPIC_API_KEY=
PHASE_AI_SALT=any-long-random-text
# optional: PHASE_AI_HOURLY=10  PHASE_AI_DAILY_CAP=300  PHASE_AI_MODEL=claude-haiku-5-5

# Weekly chat report (api/weekly-report.js): emailed every Sunday 09:00 IST, then the chats are deleted.
RESEND_API_KEY=
CRON_SECRET=another-long-random-text
# optional: REPORT_TO (default: contact email in site.config.json)  REPORT_FROM (default: Phase AI <onboarding@resend.dev>)
